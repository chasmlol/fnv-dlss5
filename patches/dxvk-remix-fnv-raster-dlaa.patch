+  // NV-DXVK start: Raster DLSS camera tracking
+  void D3D9Rtx::trackRasterDlssCamera() {
+    if (!DxvkDLSS::enableRasterDlss() ||
+        RtxOptions::enableRaytracing() ||
+        m_rasterDlssCameraQueued ||
+        !m_activePresentParams.has_value() ||
+        d3d9State().renderTargets[kRenderTargetIndex] == nullptr ||
+        d3d9State().depthStencil == nullptr ||
+        d3d9State().renderStates[D3DRS_ZENABLE] != D3DZB_TRUE ||
+        d3d9State().viewport.MaxZ < 0.9f) {
+      return;
+    }
+
+    const auto* colorDesc =
+      d3d9State().renderTargets[kRenderTargetIndex]->GetCommonTexture()->Desc();
+    if (!isRenderTargetPrimary(*m_activePresentParams, colorDesc)) {
+      return;
+    }
+
+    Matrix4 worldToView =
+      d3d9State().transforms[GetTransformIndex(D3DTS_VIEW)];
+    Matrix4 viewToProjection =
+      d3d9State().transforms[GetTransformIndex(D3DTS_PROJECTION)];
+
+    // Reject fixed-function UI and other non-perspective draws. The first
+    // full-size perspective draw is the main scene camera for this frame.
+    if (isIdentityExact(viewToProjection) ||
+        viewToProjection[3][3] == 1.0f) {
