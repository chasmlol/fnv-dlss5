+      viewToProjection,
+      depthAttachment
+    ](DxvkContext* ctx) {
+      static_cast<RtxContext*>(ctx)->processRasterDlssCamera(
+        worldToView,
+        viewToProjection,
+      depthAttachment);
+    });
+  }
