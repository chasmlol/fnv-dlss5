+    int createFlags = NVSDK_NGX_DLSS_Feature_Flags_MVLowRes;
+    createFlags |= isContentHDR ? NVSDK_NGX_DLSS_Feature_Flags_IsHDR : 0;
+    createFlags |= depthInverted ? NVSDK_NGX_DLSS_Feature_Flags_DepthInverted : 0;
+
+    m_parameters->Set("Width", inputSize[0]);
+    m_parameters->Set("Height", inputSize[1]);
+    m_parameters->Set("OutWidth", outputSize[0]);
+    m_parameters->Set("OutHeight", outputSize[1]);
+    m_parameters->Set("DLSSNR.Width", outputSize[0]);
+    m_parameters->Set("DLSSNR.Height", outputSize[1]);
+    m_parameters->Set("DLSSNR.InputWidth", inputSize[0]);
+    m_parameters->Set("DLSSNR.InputHeight", inputSize[1]);
+    m_parameters->Set("DLSSNR.OutputWidth", outputSize[0]);
+    m_parameters->Set("DLSSNR.OutputHeight", outputSize[1]);
+    m_parameters->Set("DLSSNR.Output.Width", outputSize[0]);
+    m_parameters->Set("DLSSNR.Output.Height", outputSize[1]);
+    m_parameters->Set("DLSSNR.ScalingRatio", scalingRatio);
+    m_parameters->Set("DLSSNR.Scale", scalingRatio);
+    m_parameters->Set("DLSSNR.Upscaling", upscaling);
+    m_parameters->Set(
+      "DLSSNRComputeScalingRatioCallback",
+      m_dispatch->computeScalingRatio);
+    m_parameters->Set("DLSSNRGetStatsCallback", m_dispatch->getStats);
+    m_parameters->Set("DLSSNR.Hint.Render.Preset", preset);
+    m_parameters->Set("PerfQualityValue", static_cast<int>(NVSDK_NGX_PerfQuality_Value_MaxPerf));
+    m_parameters->Set("DLSS.Feature.Create.Flags", createFlags);
+    m_parameters->Set("CreationNodeMask", 1u);
+    m_parameters->Set("VisibilityNodeMask", 1u);
+    m_parameters->Set(NVSDK_NGX_Parameter_FreeMemOnReleaseFeature, 1);
+
+    VkCommandBuffer commandBuffer =
+      renderContext->getCommandList()->getCmdBuffer(DxvkCmdBuffer::ExecBuffer);
+    constexpr NVSDK_NGX_Feature neuralRenderingFeature =
+      static_cast<NVSDK_NGX_Feature>(NVSDK_NGX_Feature_Reserved18);
+
+    m_lastResult = m_dispatch->createFeature(
+      m_device->handle(),
+      commandBuffer,
+      neuralRenderingFeature,
+      m_parameters,
+      &m_feature);
+
+    if (NVSDK_NGX_FAILED(m_lastResult) || m_feature == nullptr) {
+      Logger::warn(str::format(
+        "Failed to create DLSS Neural Rendering feature 18: ",
+        resultToString(m_lastResult),
+        ". Normal DLSS/Ray Reconstruction will remain active."));
+      m_feature = nullptr;
+      return;
+    }
+
+    Logger::info(str::format(
+      "Created DLSS Neural Rendering feature 18 in native mode at ",
+      inputSize[0], "x", inputSize[1], " -> ",
+      outputSize[0], "x", outputSize[1], "."));
+  }
+
+  void NGXNeuralRenderingContext::releaseNGXFeature() {
+    if (m_feature != nullptr) {
+      if (m_dispatch && m_dispatch->releaseFeature) {
+        m_dispatch->releaseFeature(m_feature);
+      } else {
+        NVSDK_NGX_VULKAN_ReleaseFeature(m_feature);
+      }
+      m_feature = nullptr;
+    }
+  }
+
+  bool NGXNeuralRenderingContext::evaluate(
+      Rc<DxvkContext> renderContext,
+      const NGXBuffers& buffers,
+      const NGXSettings& settings) {
+    if (m_feature == nullptr || m_parameters == nullptr || m_failureLatched) {
+      return false;
+    }
+
+    ScopedCpuProfileZone();
+
+    const uint32_t colorWidth = buffers.pColor->image->info().extent.width;
+    const uint32_t colorHeight = buffers.pColor->image->info().extent.height;
+    const uint32_t outputWidth = buffers.pOutput->image->info().extent.width;
+    const uint32_t outputHeight = buffers.pOutput->image->info().extent.height;
+    const uint32_t guideWidth = buffers.pDepth->image->info().extent.width;
+    const uint32_t guideHeight = buffers.pDepth->image->info().extent.height;
+
+    NVSDK_NGX_Resource_VK color = TextureToResourceVK(buffers.pColor, false);
+    NVSDK_NGX_Resource_VK output = TextureToResourceVK(buffers.pOutput, true);
+    NVSDK_NGX_Resource_VK motionVectors = TextureToResourceVK(buffers.pMotionVectors, false);
+    NVSDK_NGX_Resource_VK depth = TextureToResourceVK(buffers.pDepth, false);
+
+    m_parameters->Set("DLSSNR.Color", static_cast<void*>(&color));
+    m_parameters->Set("DLSSNR.Output", static_cast<void*>(&output));
+    m_parameters->Set("DLSSNR.MVec", static_cast<void*>(&motionVectors));
+    m_parameters->Set("DLSSNR.Depth", static_cast<void*>(&depth));
+
+    m_parameters->Set("Width", colorWidth);
+    m_parameters->Set("Height", colorHeight);
+    m_parameters->Set("OutWidth", outputWidth);
+    m_parameters->Set("OutHeight", outputHeight);
+
+    m_parameters->Set("DLSSNR.ColorSubrectBaseX", 0u);
+    m_parameters->Set("DLSSNR.ColorSubrectBaseY", 0u);
+    m_parameters->Set("DLSSNR.ColorSubrectWidth", colorWidth);
+    m_parameters->Set("DLSSNR.ColorSubrectHeight", colorHeight);
+    m_parameters->Set("DLSSNR.DepthSubrectBaseX", 0u);
+    m_parameters->Set("DLSSNR.DepthSubrectBaseY", 0u);
+    m_parameters->Set("DLSSNR.DepthSubrectWidth", guideWidth);
+    m_parameters->Set("DLSSNR.DepthSubrectHeight", guideHeight);
+    m_parameters->Set("DLSSNR.MVecSubrectBaseX", 0u);
+    m_parameters->Set("DLSSNR.MVecSubrectBaseY", 0u);
+    m_parameters->Set("DLSSNR.MVecSubrectWidth", guideWidth);
+    m_parameters->Set("DLSSNR.MVecSubrectHeight", guideHeight);
+    m_parameters->Set("DLSSNR.OutputSubrectBaseX", 0u);
+    m_parameters->Set("DLSSNR.OutputSubrectBaseY", 0u);
+    m_parameters->Set("DLSSNR.OutputSubrectWidth", outputWidth);
+    m_parameters->Set("DLSSNR.OutputSubrectHeight", outputHeight);
+
+    m_parameters->Set("DLSSNR.InputWidth", colorWidth);
+    m_parameters->Set("DLSSNR.InputHeight", colorHeight);
+    m_parameters->Set("DLSSNR.OutputWidth", outputWidth);
+    m_parameters->Set("DLSSNR.OutputHeight", outputHeight);
+    m_parameters->Set("DLSSNR.ScalingRatio", 1.0f);
+    m_parameters->Set("DLSSNR.Scale", 1.0f);
+    m_parameters->Set("DLSSNR.Upscaling", 0);
+    m_parameters->Set(
+      "DLSSNRComputeScalingRatioCallback",
+      m_dispatch->computeScalingRatio);
+    m_parameters->Set("DLSSNRGetStatsCallback", m_dispatch->getStats);
+    m_parameters->Set("DLSSNR.MVecScaleX", settings.motionVectorScale[0]);
+    m_parameters->Set("DLSSNR.MVecScaleY", settings.motionVectorScale[1]);
+    m_parameters->Set("DLSSNR.DepthInverted", settings.depthInverted ? 1 : 0);
+    m_parameters->Set("DLSSNR.Enabled", 1);
+    m_parameters->Set("DLSSNR.Reset", settings.resetAccumulation ? 1 : 0);
+    m_parameters->Set("DLSSNR.Intensity", settings.intensity);
+    m_parameters->Set("DLSSNR.LocalToneStrength", settings.localToneStrength);
+    m_parameters->Set("DLSSNR.LocalStructureStrength", settings.localStructureStrength);
+    m_parameters->Set("DLSSNR.SkinStructureStrength", settings.skinStructureStrength);
+    m_parameters->Set("DLSSNR.UseAutoMask", settings.useAutoMask ? 1 : 0);
+    m_parameters->Set("DLSSNR.Style", settings.style);
+    m_parameters->Set("DLSSNR.UICorrection", settings.uiCorrection ? 1 : 0);
+    m_parameters->Set("DLSS.Indicator.Invert.X.Axis", 0);
+    m_parameters->Set("DLSS.Indicator.Invert.Y.Axis", 0);
+
+    VkCommandBuffer commandBuffer =
+      renderContext->getCommandList()->getCmdBuffer(DxvkCmdBuffer::ExecBuffer);
+    m_lastResult = m_dispatch->evaluateFeature(
+      commandBuffer, m_feature, m_parameters, nullptr);
+
+    if (NVSDK_NGX_FAILED(m_lastResult)) {
+      ++m_failedEvaluations;
+      ++m_consecutiveFailures;
+      if (m_consecutiveFailures == 1) {
+        Logger::warn(str::format(
+          "DLSS Neural Rendering evaluation failed: ",
+          resultToString(m_lastResult),
+          ". Preserving the normal DLSS/Ray Reconstruction output."));
+      }
+      if (m_consecutiveFailures >= 3) {
+        m_failureLatched = true;
+        Logger::warn(
+          "DLSS Neural Rendering disabled after 3 consecutive failures. "
+          "Toggle it off/on or press its reset button to retry.");
+      }
+      return false;
+    }
+
+    m_consecutiveFailures = 0;
+    ++m_successfulEvaluations;
+    if (m_successfulEvaluations == 1) {
+      Logger::info(str::format(
+        "DLSS Neural Rendering produced its first frame (color ",
+        colorWidth, "x", colorHeight, ", guides ",
+        guideWidth, "x", guideHeight, ", output ",
+        outputWidth, "x", outputHeight, ")."));
+    }
+    return true;
+  }
+
