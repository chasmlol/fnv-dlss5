+#include "rtx/pass/raster_dlss/raster_dlss_prepare.h"
+
+layout(binding = RASTER_DLSS_DEPTH_INPUT)
+Texture2D<float> RasterDepth;
+
+layout(r32f, binding = RASTER_DLSS_DEPTH_OUTPUT)
+RWTexture2D<float> DlssDepth;
+
+layout(rg16f, binding = RASTER_DLSS_MOTION_OUTPUT)
+RWTexture2D<float2> DlssMotion;
+
+layout(push_constant)
+ConstantBuffer<RasterDlssPrepareArgs> cb;
+
+[shader("compute")]
+[numthreads(RASTER_DLSS_TILE_SIZE, RASTER_DLSS_TILE_SIZE, 1)]
+void main(in uint2 pixel : SV_DispatchThreadID) {
+  if (any(pixel >= cb.resolution)) {
+    return;
+  }
+
+  const float depth = RasterDepth[pixel];
+  DlssDepth[pixel] = depth;
+
+  if (cb.resetHistory != 0) {
+    DlssMotion[pixel] = float2(0.0f, 0.0f);
+    return;
+  }
+
+  const float2 uv = (float2(pixel) + 0.5f) / float2(cb.resolution);
+  const float2 rasterNdc =
+    uv * float2(2.0f, -2.0f) + float2(-1.0f, 1.0f);
+  const float2 currentNdc = rasterNdc - cb.currentJitterNdc;
+  const float4 currentClip =
+    float4(currentNdc, depth, 1.0f);
+  const float4 previousClip = mul(cb.clipToPrevClip, currentClip);
+
+  if (abs(previousClip.w) < 1.0e-7f) {
+    DlssMotion[pixel] = float2(0.0f, 0.0f);
+    return;
+  }
+
+  const float2 previousNdc = previousClip.xy / previousClip.w;
+  const float2 motionNdc = previousNdc - currentNdc;
+  DlssMotion[pixel] =
+    motionNdc * float2(0.5f, -0.5f) * float2(cb.resolution);
+}
