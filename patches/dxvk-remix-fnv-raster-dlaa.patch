+
+  void DxvkDLSS::releaseNeuralRendering() {
+    if (m_neuralRenderingContext) {
+      m_neuralRenderingContext->releaseNGXFeature();
+    }
+    m_neuralRenderingContext = nullptr;
+    m_neuralRenderingInputSize[0] = 0;
+    m_neuralRenderingInputSize[1] = 0;
+    m_neuralRenderingOutputSize[0] = 0;
+    m_neuralRenderingOutputSize[1] = 0;
+    m_neuralRenderingReset = true;
+    m_neuralRenderingWasEnabled = false;
+  }
+
+  void DxvkDLSS::dispatchNeuralRendering(
+      Rc<RtxContext> ctx,
+      DxvkBarrierSet& barriers,
+      const Resources::RaytracingOutput& rtOutput,
+      const Resources::Resource* motionVectors,
+      const Resources::Resource* depth,
+      bool resetHistory) {
+    if (!enableNeuralRendering()) {
+      if (m_neuralRenderingWasEnabled) {
+        releaseNeuralRendering();
+      }
+      return;
+    }
+
+    m_neuralRenderingWasEnabled = true;
+
+    const Resources::Resource& color =
+      rtOutput.m_finalOutput.resource(Resources::AccessType::Read);
+    const Resources::Resource& output = rtOutput.m_postFxIntermediateTexture;
+    const VkExtent3D colorExtent = color.image->info().extent;
+    const VkExtent3D outputExtent = output.image->info().extent;
+
+    const bool recreate =
+      m_neuralRenderingInputSize[0] != colorExtent.width ||
+      m_neuralRenderingInputSize[1] != colorExtent.height ||
+      m_neuralRenderingOutputSize[0] != outputExtent.width ||
+      m_neuralRenderingOutputSize[1] != outputExtent.height ||
+      m_prevNeuralRenderingPreset != neuralRenderingPreset();
+
+    if (recreate) {
+      m_device->waitForIdle();
+
+      if (!m_neuralRenderingContext) {
+        m_neuralRenderingContext =
+          m_device->getCommon()->metaNGXContext().createNeuralRenderingContext();
+      }
+
+      m_neuralRenderingInputSize[0] = colorExtent.width;
+      m_neuralRenderingInputSize[1] = colorExtent.height;
+      m_neuralRenderingOutputSize[0] = outputExtent.width;
+      m_neuralRenderingOutputSize[1] = outputExtent.height;
+      m_prevNeuralRenderingPreset = neuralRenderingPreset();
+      m_neuralRenderingReset = true;
+
+      if (m_neuralRenderingContext) {
+        uint32_t inputSize[2] = { colorExtent.width, colorExtent.height };
+        uint32_t outputSize[2] = { outputExtent.width, outputExtent.height };
+
+        bool depthInverted = mInverseDepth;
+        switch (neuralRenderingDepthMode()) {
+        case NeuralRenderingDepthMode::ForceNormal:
+          depthInverted = false;
+          break;
+        case NeuralRenderingDepthMode::ForceInverted:
+          depthInverted = true;
+          break;
+        default:
+          break;
+        }
+
+        m_neuralRenderingContext->initialize(
+          ctx,
+          inputSize,
+          outputSize,
+          mIsHDR,
+          depthInverted,
+          static_cast<uint32_t>(neuralRenderingPreset()));
+      }
+    }
+
+    if (!m_neuralRenderingContext || !m_neuralRenderingContext->isInitialized()) {
+      return;
+    }
+
+    Rc<DxvkImageView> colorView = color.view;
+    Rc<DxvkImageView> outputView = output.view;
+    Rc<DxvkImageView> motionView = motionVectors->view;
+    Rc<DxvkImageView> depthView = depth->view;
+
+    for (const auto& input : { colorView, motionView, depthView }) {
+      barriers.accessImage(
+        input->image(),
+        input->imageSubresources(),
+        input->imageInfo().layout,
+        input->imageInfo().stages,
+        input->imageInfo().access,
+        input->imageInfo().layout,
+        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+        VK_ACCESS_SHADER_READ_BIT);
+    }
+    barriers.accessImage(
+      outputView->image(),
+      outputView->imageSubresources(),
+      outputView->imageInfo().layout,
+      outputView->imageInfo().stages,
+      outputView->imageInfo().access,
+      outputView->imageInfo().layout,
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      VK_ACCESS_SHADER_WRITE_BIT);
+    barriers.recordCommands(ctx->getCommandList());
+
+    bool depthInverted = mInverseDepth;
+    switch (neuralRenderingDepthMode()) {
+    case NeuralRenderingDepthMode::ForceNormal:
+      depthInverted = false;
+      break;
+    case NeuralRenderingDepthMode::ForceInverted:
+      depthInverted = true;
+      break;
+    default:
+      break;
+    }
+
+    NGXNeuralRenderingContext::NGXBuffers buffers;
+    buffers.pColor = &color;
+    buffers.pOutput = &output;
+    buffers.pMotionVectors = motionVectors;
+    buffers.pDepth = depth;
+
+    NGXNeuralRenderingContext::NGXSettings settings;
+    settings.resetAccumulation = resetHistory || m_neuralRenderingReset;
+    settings.depthInverted = depthInverted;
+    settings.useAutoMask = neuralRenderingAutoMask();
+    settings.uiCorrection = neuralRenderingUICorrection();
+    settings.motionVectorScale[0] = neuralRenderingMotionScaleX();
+    settings.motionVectorScale[1] = neuralRenderingMotionScaleY();
+    settings.intensity = neuralRenderingIntensity();
+    settings.localToneStrength = neuralRenderingLocalToneStrength();
+    settings.localStructureStrength = neuralRenderingLocalStructureStrength();
+    settings.skinStructureStrength = neuralRenderingSkinStructureStrength();
+    settings.style = static_cast<uint32_t>(neuralRenderingStyle());
+
+    const bool success = m_neuralRenderingContext->evaluate(ctx, buffers, settings);
+
+    for (const auto& input : { colorView, motionView, depthView }) {
+      barriers.accessImage(
+        input->image(),
+        input->imageSubresources(),
+        input->imageInfo().layout,
+        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+        VK_ACCESS_SHADER_READ_BIT,
+        input->imageInfo().layout,
+        input->imageInfo().stages,
+        input->imageInfo().access);
+      ctx->getCommandList()->trackResource<DxvkAccess::Read>(input->image());
+    }
+    barriers.accessImage(
+      outputView->image(),
+      outputView->imageSubresources(),
+      outputView->imageInfo().layout,
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      VK_ACCESS_SHADER_WRITE_BIT,
+      outputView->imageInfo().layout,
+      outputView->imageInfo().stages,
+      outputView->imageInfo().access);
+    ctx->getCommandList()->trackResource<DxvkAccess::Write>(outputView->image());
+    barriers.recordCommands(ctx->getCommandList());
+
+    if (!success) {
+      return;
+    }
+
+    m_neuralRenderingReset = false;
+    ctx->copyImage(
+      rtOutput.m_finalOutput.resource(Resources::AccessType::Write).image,
+      { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+      { 0, 0, 0 },
+      output.image,
+      { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+      { 0, 0, 0 },
+      outputExtent);
+  }
