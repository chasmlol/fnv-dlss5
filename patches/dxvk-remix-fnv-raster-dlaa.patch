+      bool resetHistory,
+      float jitterX,
+      float jitterY);
+    void release();
+
+    bool isInitialized() const;
+    const char* status() const;
+
+    const Resources::Resource& color() const;
+    const Resources::Resource& depth() const;
+    const Resources::Resource& motion() const;
+    const Resources::Resource& output() const;
+
+  private:
+    struct Impl;
+    std::unique_ptr<Impl> m_impl;
+  };
+
+}
