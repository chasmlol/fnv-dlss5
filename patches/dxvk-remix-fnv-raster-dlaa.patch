+  void RtxContext::processRasterDlssCamera(
+    const Matrix4& worldToView,
+    const Matrix4& viewToProjection,
+    const Rc<DxvkImageView>& depthAttachment) {
+    if (!DxvkDLSS::enableRasterDlss() ||
+        RtxOptions::enableRaytracing() ||
+        depthAttachment == nullptr) {
+      return;
+    }
+
+    const uint32_t frameId = m_device->getCurrentFrameId();
+    RtCamera& camera =
+      getSceneManager().getCameraManager().getMainCamera();
+
+    // Raster DLAA evaluates the native D3D9 backbuffer, even when Remix's
+    // regular DLSS quality option has allocated lower-resolution ray-tracing
+    // resources. Jitter must therefore be converted with the native raster
+    // depth extent or the scene receives a larger clip-space offset than NGX
+    // is told to remove.
+    const VkExtent3D rasterExtent =
+      depthAttachment->image()->info().extent;
+    const uint32_t rasterResolution[2] = {
+      rasterExtent.width,
+      rasterExtent.height
+    };
+    camera.setResolution(
+      rasterResolution,
+      rasterResolution);
+
+    if (!camera.isValid(frameId)) {
+      getSceneManager().getCameraManager().processExternalCamera(
+        CameraType::Main,
+        worldToView,
+        viewToProjection);
+    }
+
+    m_rasterDlssDepthAttachment = depthAttachment;
+    m_rasterDlssDepthFrame = frameId;
+    setRasterDlssSceneJitter(true);
+    ONCE(Logger::info(
+      "Raster DLSS captured its first New Vegas camera/depth pair."));
+  }
+
+  void RtxContext::setRasterDlssSceneJitter(bool enable) {
+    if (!enable) {
+      if (m_rasterDlssSceneJitterEnabled) {
+        setSpecConstant(
+          VK_PIPELINE_BIND_POINT_GRAPHICS,
+          D3D9SpecConstantId::ClipSpaceJitterEnabled,
+          false);
+        m_rasterDlssSceneJitterEnabled = false;
+      }
+      return;
+    }
+
+    if (m_rtState.vertexCaptureCB == nullptr) {
+      ONCE(Logger::warn(
+        "Raster DLSS could not apply scene jitter because the D3D9 vertex constant buffer is unavailable."));
+      return;
+    }
+
+    RtCamera& camera =
+      getSceneManager().getCameraManager().getMainCamera();
+    const uint32_t frameId = m_device->getCurrentFrameId();
+    if (!camera.isValid(frameId)) {
+      return;
+    }
+
+    float pixelJitter[2] = {};
+    camera.getJittering(pixelJitter);
+
+    const Matrix4d& viewToProjection =
+      camera.getViewToProjection();
+    const float ratioX = Sign(viewToProjection[2][3]);
+    const float ratioY = -Sign(viewToProjection[2][3]);
+    const Vector2 clipSpaceJitter = camera.calcClipSpaceJitter(
+      Vector2(pixelJitter[0], pixelJitter[1]),
+      ratioX,
+      ratioY);
+
+    D3D9RtxVertexCaptureData modified =
+      *static_cast<D3D9RtxVertexCaptureData*>(
+        m_rtState.vertexCaptureCB->mapPtr(0));
+    modified.jitterX = clipSpaceJitter.x;
+    modified.jitterY = clipSpaceJitter.y;
+    allocAndMapVertexCaptureConstantBuffer() = modified;
+
+    setSpecConstant(
+      VK_PIPELINE_BIND_POINT_GRAPHICS,
+      D3D9SpecConstantId::ClipSpaceJitterEnabled,
+      true);
+    m_rasterDlssSceneJitterEnabled = true;
+
+    ONCE(Logger::info(str::format(
+      "Raster DLSS applied sub-pixel jitter to the New Vegas scene: pixel=(",
+      pixelJitter[0],
+      ", ",
+      pixelJitter[1],
+      "), clip=(",
+      clipSpaceJitter.x,
+      ", ",
+      clipSpaceJitter.y,
+      ").")));
+  }
+
