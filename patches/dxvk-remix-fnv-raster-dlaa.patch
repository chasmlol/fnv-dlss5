+  bool DxvkDLSS::dispatchRaster(
+    Rc<RtxContext> ctx,
+    DxvkBarrierSet& barriers,
+    const Rc<DxvkImage>& colorImage,
+    const Rc<DxvkImageView>& depthAttachment,
+    bool resetHistory) {
+    ScopedGpuProfileZone(ctx, "Raster DLSS");
+    ctx->setFramePassStage(RtxFramePassStage::DLSS);
+
+    if (colorImage == nullptr || depthAttachment == nullptr) {
+      return false;
+    }
+
+    const DxvkImageCreateInfo& colorInfo = colorImage->info();
+    const Rc<DxvkImage>& sourceDepthImage = depthAttachment->image();
+    const DxvkImageCreateInfo& sourceDepthInfo = sourceDepthImage->info();
+    if (colorInfo.sampleCount != VK_SAMPLE_COUNT_1_BIT ||
+        sourceDepthInfo.sampleCount != VK_SAMPLE_COUNT_1_BIT ||
+        colorInfo.extent != sourceDepthInfo.extent ||
+        !(colorInfo.usage & VK_IMAGE_USAGE_SAMPLED_BIT) ||
+        !(sourceDepthInfo.usage & VK_IMAGE_USAGE_SAMPLED_BIT)) {
+      ONCE(Logger::warn(
+        "Raster DLSS requires matching, single-sample color and depth images with sampled usage."));
+      return false;
+    }
+
+    const uint32_t displaySize[2] = {
+      colorInfo.extent.width,
+      colorInfo.extent.height
+    };
+    uint32_t renderSize[2] = {};
+    setSetting(displaySize, DLSSProfile::FullResolution, renderSize);
+    if (renderSize[0] != displaySize[0] ||
+        renderSize[1] != displaySize[1]) {
+      ONCE(Logger::warn(
+        "Raster DLSS currently supports native-resolution DLAA only."));
+      return false;
+    }
+
+    if (!m_d3d12Dlaa ||
+        !m_d3d12Dlaa->ensureResources(ctx, colorInfo.extent)) {
+      ++m_rasterFailedEvaluations;
+      return false;
+    }
+
+    if (m_rasterDepthView == nullptr ||
+        m_rasterDepthView->image() != sourceDepthImage) {
+      DxvkImageViewCreateInfo viewInfo = depthAttachment->info();
+      viewInfo.type = VK_IMAGE_VIEW_TYPE_2D;
+      viewInfo.format = sourceDepthInfo.format;
+      viewInfo.usage = VK_IMAGE_USAGE_SAMPLED_BIT;
+      viewInfo.aspect = VK_IMAGE_ASPECT_DEPTH_BIT;
+      viewInfo.minLevel = 0;
+      viewInfo.numLevels = 1;
+      viewInfo.minLayer = 0;
+      viewInfo.numLayers = 1;
+      m_rasterDepthView =
+        m_device->createImageView(sourceDepthImage, viewInfo);
+    }
+
+    const Resources::Resource& sharedColor = m_d3d12Dlaa->color();
+    const Resources::Resource& sharedDepth = m_d3d12Dlaa->depth();
+    const Resources::Resource& sharedMotion = m_d3d12Dlaa->motion();
+    const Resources::Resource& sharedOutput = m_d3d12Dlaa->output();
+
+    RtxContext::blitImageHelper(
+      ctx,
+      colorImage,
+      sharedColor.image,
+      VK_FILTER_NEAREST);
+
+    SceneManager& sceneManager =
+      device()->getCommon()->getSceneManager();
+    RtCamera& camera = sceneManager.getCamera();
+    resetHistory |=
+      camera.isViewHistoryInvalidated(m_device->getCurrentFrameId());
+
+    const Matrix4 clipToPrevClip =
+      camera.getPreviousViewToProjection() *
+      camera.getPreviousWorldToView() *
+      camera.getViewToWorld() *
+      camera.getProjectionToView();
+    float pixelJitter[2] = {};
+    camera.getJittering(pixelJitter);
+    const Matrix4d& viewToProjection =
+      camera.getViewToProjection();
+    const Vector2 currentJitterNdc =
+      camera.calcClipSpaceJitter(
+        Vector2(pixelJitter[0], pixelJitter[1]),
+        Sign(viewToProjection[2][3]),
+        -Sign(viewToProjection[2][3]));
+
+    RasterDlssPrepareArgs prepareArgs = {};
+    prepareArgs.clipToPrevClip = clipToPrevClip;
+    prepareArgs.resolution = {
+      colorInfo.extent.width,
+      colorInfo.extent.height
+    };
+    prepareArgs.currentJitterNdc = {
+      currentJitterNdc.x,
+      currentJitterNdc.y
+    };
+    prepareArgs.resetHistory = resetHistory ? 1u : 0u;
+
+    ctx->pushConstants(
+      0,
+      sizeof(prepareArgs),
+      &prepareArgs);
+    ctx->bindResourceView(
+      RASTER_DLSS_DEPTH_INPUT,
+      m_rasterDepthView,
+      nullptr);
+    ctx->bindResourceView(
+      RASTER_DLSS_DEPTH_OUTPUT,
+      sharedDepth.view,
+      nullptr);
+    ctx->bindResourceView(
+      RASTER_DLSS_MOTION_OUTPUT,
+      sharedMotion.view,
+      nullptr);
+    ctx->bindShader(
+      VK_SHADER_STAGE_COMPUTE_BIT,
+      RasterDlssPrepareShader::getShader());
+
+    const VkExtent3D workgroups = util::computeBlockCount(
+      colorInfo.extent,
+      VkExtent3D {
+        RASTER_DLSS_TILE_SIZE,
+        RASTER_DLSS_TILE_SIZE,
+        1
+      });
+    ctx->dispatch(
+      workgroups.width,
+      workgroups.height,
+      workgroups.depth);
+
+    const std::vector<Rc<DxvkImageView>> inputs = {
+      sharedColor.view,
+      sharedMotion.view,
+      sharedDepth.view
+    };
+    for (const auto& input : inputs) {
+      barriers.accessImage(
+        input->image(),
+        input->imageSubresources(),
+        input->imageInfo().layout,
+        input->imageInfo().stages,
+        input->imageInfo().access,
+        input->imageInfo().layout,
+        VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+        VK_ACCESS_MEMORY_READ_BIT);
     }
+    barriers.recordCommands(ctx->getCommandList());
+
+    // The host signals a shared Vulkan/D3D12 timeline fence before and after
+    // the NGX evaluation. The CPU wait is intentionally retained for this
+    // first correctness build, but the fence provides the required memory
+    // visibility and queue ordering across both graphics APIs.
+    const bool success = m_d3d12Dlaa->evaluate(
+      ctx,
+      resetHistory,
+      pixelJitter[0],
+      pixelJitter[1]);
+
+    if (!success) {
+      ++m_rasterFailedEvaluations;
+      return false;
+    }
+
+    ++m_rasterSuccessfulEvaluations;
+    if (!m_rasterFirstSuccessLogged) {
+      m_rasterFirstSuccessLogged = true;
+      Logger::info(
+        "Raster DLSS completed its first D3D12 DLAA host evaluation.");
+    }
+
+    // Acquire visibility of the D3D12 output before Vulkan presents it.
+    ctx->emitMemoryBarrier(
+      0,
+      VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+      VK_ACCESS_MEMORY_WRITE_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_ACCESS_TRANSFER_READ_BIT);
+
+    RtxContext::blitImageHelper(
+      ctx,
+      sharedOutput.image,
+      colorImage,
+      VK_FILTER_NEAREST);
+    return true;
   }
 
