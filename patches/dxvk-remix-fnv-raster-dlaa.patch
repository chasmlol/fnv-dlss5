+  bool NGXNeuralRenderingContext::initializeSnippet() {
+    if (m_dispatch && m_dispatch->initialized) {
+      return true;
+    }
+
+    const std::string exePath = env::getExePath();
+    const std::string exeFolder = exePath.substr(0, exePath.find_last_of("\\/"));
+    const std::wstring dllPath =
+      str::tows(exeFolder.c_str()) + L"\\.trex\\nvngx_dlssnr.dll";
+
+    auto dispatch = std::make_unique<NGXNeuralRenderingDispatch>();
+    dispatch->module = LoadLibraryW(dllPath.c_str());
+    if (dispatch->module == nullptr) {
+      Logger::warn(str::format(
+        "DLSS Neural Rendering runtime was not found at ",
+        str::fromws(dllPath.c_str()), "."));
+      return false;
+    }
+
+    auto* moduleBase = reinterpret_cast<uint8_t*>(dispatch->module);
+    auto* exportedInit = reinterpret_cast<uint8_t*>(
+      GetProcAddress(dispatch->module, "NVSDK_NGX_VULKAN_Init_Ext2"));
+    auto* exportedCreate = reinterpret_cast<uint8_t*>(
+      GetProcAddress(dispatch->module, "NVSDK_NGX_VULKAN_CreateFeature1"));
+    auto* exportedEvaluate = GetProcAddress(
+      dispatch->module, "NVSDK_NGX_VULKAN_EvaluateFeature");
+
+    // The 310.8 DLSSNR snippet only accepts its public entry points when
+    // nvngx.dll is the direct caller. Remix's NGX core does not currently
+    // route reserved feature 18 to this snippet, so use the snippet's native
+    // implementations after positively identifying this exact runtime layout.
+    constexpr ptrdiff_t kInitExportRva = 0x251a0;
+    constexpr ptrdiff_t kCreateExportRva = 0x24b70;
+    constexpr ptrdiff_t kInitImplementationRva = 0x23dd0;
+    constexpr ptrdiff_t kCreateImplementationRva = 0x23c70;
+    constexpr ptrdiff_t kReleaseImplementationRva = 0x240a0;
+    constexpr ptrdiff_t kShutdownImplementationRva = 0x24290;
+    constexpr ptrdiff_t kComputeScalingRatioRva = 0x248c0;
+    constexpr ptrdiff_t kGetStatsRva = 0x12e80;
+
+    if (exportedInit != moduleBase + kInitExportRva ||
+        exportedCreate != moduleBase + kCreateExportRva ||
+        exportedEvaluate == nullptr) {
+      Logger::warn(
+        "nvngx_dlssnr.dll is not the supported 310.8 runtime layout. "
+        "DLSS Neural Rendering will remain disabled rather than calling "
+        "unknown private entry points.");
+      FreeLibrary(dispatch->module);
+      return false;
+    }
+
+    dispatch->init = reinterpret_cast<NGXNeuralRenderingDispatch::InitFn>(
+      moduleBase + kInitImplementationRva);
+    dispatch->createFeature =
+      reinterpret_cast<NGXNeuralRenderingDispatch::CreateFeatureFn>(
+        moduleBase + kCreateImplementationRva);
+    dispatch->evaluateFeature =
+      reinterpret_cast<NGXNeuralRenderingDispatch::EvaluateFeatureFn>(
+        exportedEvaluate);
+    dispatch->releaseFeature =
+      reinterpret_cast<NGXNeuralRenderingDispatch::ReleaseFeatureFn>(
+        moduleBase + kReleaseImplementationRva);
+    dispatch->shutdown =
+      reinterpret_cast<NGXNeuralRenderingDispatch::ShutdownFn>(
+        moduleBase + kShutdownImplementationRva);
+    dispatch->computeScalingRatio = moduleBase + kComputeScalingRatioRva;
+    dispatch->getStats = moduleBase + kGetStatsRva;
+
+    auto adapter = m_device->adapter();
+    auto instance = m_device->instance();
+    m_lastResult = dispatch->init(
+      RtxOptions::applicationId(),
+      str::tows(exeFolder.c_str()).c_str(),
+      NVSDK_NGX_Version_API,
+      m_parameters,
+      m_device->handle(),
+      instance->handle(),
+      adapter->handle(),
+      nullptr,
+      nullptr);
+    if (NVSDK_NGX_FAILED(m_lastResult)) {
+      Logger::warn(str::format(
+        "Failed to initialize the DLSS Neural Rendering 310.8 snippet: ",
+        resultToString(m_lastResult), "."));
+      FreeLibrary(dispatch->module);
+      return false;
+    }
+
+    dispatch->initialized = true;
+    m_dispatch = std::move(dispatch);
+    Logger::info(
+      "Initialized the DLSS Neural Rendering 310.8 snippet through its "
+      "native Vulkan implementation.");
+    return true;
+  }
+
+  void NGXNeuralRenderingContext::shutdownSnippet() {
+    if (!m_dispatch) {
+      return;
+    }
+
+    if (m_dispatch->initialized && m_dispatch->shutdown != nullptr) {
+      m_dispatch->shutdown(m_device->handle(), true);
+      m_dispatch->initialized = false;
+    }
+    if (m_dispatch->module != nullptr) {
+      FreeLibrary(m_dispatch->module);
+      m_dispatch->module = nullptr;
+    }
+    m_dispatch.reset();
+  }
