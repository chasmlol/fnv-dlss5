+  void DxvkDLSS::showNeuralRenderingImguiSettings(bool showAdvancedSettings) {
+    if (!RemixGui::CollapsingHeader("DLSS Neural Rendering")) {
+      return;
+    }
+
+    ImGui::Indent();
+    bool changed = RemixGui::Checkbox(
+      "Enable Neural Rendering",
+      &enableNeuralRenderingObject());
+
+    if (enableNeuralRendering()) {
+      changed |= RemixGui::Combo(
+        "NR Preset",
+        &neuralRenderingPresetObject(),
+        "Default\0Preset #1\0Preset #2\0Preset #3\0");
+      changed |= RemixGui::Combo(
+        "NR Style",
+        &neuralRenderingStyleObject(),
+        "Default\0Natural\0Cinematic\0");
+      changed |= RemixGui::DragFloat(
+        "NR Intensity",
+        &neuralRenderingIntensityObject(),
+        0.01f, 0.0f, 2.0f, "%.3f", ImGuiSliderFlags_AlwaysClamp);
+      changed |= RemixGui::DragFloat(
+        "Local Tone Strength",
+        &neuralRenderingLocalToneStrengthObject(),
+        0.01f, 0.0f, 2.0f, "%.3f", ImGuiSliderFlags_AlwaysClamp);
+      changed |= RemixGui::DragFloat(
+        "Local Structure Strength",
+        &neuralRenderingLocalStructureStrengthObject(),
+        0.01f, 0.0f, 2.0f, "%.3f", ImGuiSliderFlags_AlwaysClamp);
+      changed |= RemixGui::DragFloat(
+        "Skin Structure Strength",
+        &neuralRenderingSkinStructureStrengthObject(),
+        0.01f, -1.0f, 2.0f, "%.3f", ImGuiSliderFlags_AlwaysClamp);
+      changed |= RemixGui::Checkbox(
+        "Automatic Mask",
+        &neuralRenderingAutoMaskObject());
+      changed |= RemixGui::Checkbox(
+        "UI Correction",
+        &neuralRenderingUICorrectionObject());
+
+      if (showAdvancedSettings) {
+        changed |= RemixGui::Combo(
+          "Depth Convention",
+          &neuralRenderingDepthModeObject(),
+          "Use DLSS Flag\0Force Normal\0Force Inverted\0");
+        changed |= RemixGui::DragFloat(
+          "Motion Scale X",
+          &neuralRenderingMotionScaleXObject(),
+          0.01f, -2.0f, 2.0f, "%.3f", ImGuiSliderFlags_AlwaysClamp);
+        changed |= RemixGui::DragFloat(
+          "Motion Scale Y",
+          &neuralRenderingMotionScaleYObject(),
+          0.01f, -2.0f, 2.0f, "%.3f", ImGuiSliderFlags_AlwaysClamp);
+      }
+
+      if (m_neuralRenderingContext && m_neuralRenderingContext->isInitialized()) {
+        ImGui::Text(
+          "Status: active | successful frames: %llu | failures: %llu",
+          static_cast<unsigned long long>(m_neuralRenderingContext->successfulEvaluations()),
+          static_cast<unsigned long long>(m_neuralRenderingContext->failedEvaluations()));
+      } else {
+        ImGui::TextUnformatted("Status: waiting for feature creation (check Remix log if it stays here)");
+      }
+
+      if (ImGui::Button("Reset Neural Rendering")) {
+        releaseNeuralRendering();
+        changed = true;
+      }
+    }
+
+    if (changed) {
+      m_neuralRenderingReset = true;
+    }
+    ImGui::Unindent();
   }
 
