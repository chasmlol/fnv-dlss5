+namespace dxvk {
+  namespace {
+    using Microsoft::WRL::ComPtr;
+
+    struct SharedTexture {
+      ComPtr<ID3D12Resource> d3d12;
+      HANDLE handle = INVALID_HANDLE_VALUE;
+      Resources::Resource vulkan;
+
+      void reset() {
+        // The Vulkan import must be destroyed before its D3D12 allocation.
+        vulkan.reset();
+
+        if (handle != INVALID_HANDLE_VALUE) {
+          CloseHandle(handle);
+          handle = INVALID_HANDLE_VALUE;
+        }
+
+        d3d12.Reset();
+      }
+    };
+
+    std::filesystem::path executableDirectory() {
+      std::array<wchar_t, 32768> path = {};
+      const DWORD length = GetModuleFileNameW(
+        nullptr,
+        path.data(),
+        static_cast<DWORD>(path.size()));
+      if (length == 0 || length >= path.size()) {
+        return std::filesystem::current_path();
+      }
+
+      return std::filesystem::path(
+        std::wstring_view(path.data(), length)).parent_path();
+    }
+
+    bool sameLuid(const LUID& lhs, const uint8_t* rhs) {
+      return std::memcmp(&lhs, rhs, sizeof(LUID)) == 0;
+    }
+
+    D3D12_RESOURCE_BARRIER transition(
+      ID3D12Resource* resource,
+      D3D12_RESOURCE_STATES before,
+      D3D12_RESOURCE_STATES after) {
+      D3D12_RESOURCE_BARRIER barrier = {};
+      barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+      barrier.Flags = D3D12_RESOURCE_BARRIER_FLAG_NONE;
+      barrier.Transition.pResource = resource;
+      barrier.Transition.Subresource =
+        D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+      barrier.Transition.StateBefore = before;
+      barrier.Transition.StateAfter = after;
+      return barrier;
+    }
+  }
+
+  struct D3D12DlaaInterop::Impl {
+    explicit Impl(DxvkDevice* device)
+    : device(device) {
+    }
+
+    ~Impl() {
+      release();
+    }
+
+    bool initializeHost() {
+      if (initialized) {
+        return true;
+      }
+
+      if (d3d12Module ||
+          dxgiModule ||
+          d3d12Device ||
+          ngxInitialized) {
+        release();
+      }
+
+      statusText = "creating matching D3D12 device";
+
+      d3d12Module = LoadLibraryExW(
+        L"d3d12.dll",
+        nullptr,
+        LOAD_LIBRARY_SEARCH_SYSTEM32);
+      dxgiModule = LoadLibraryExW(
+        L"dxgi.dll",
+        nullptr,
+        LOAD_LIBRARY_SEARCH_SYSTEM32);
+      if (!d3d12Module || !dxgiModule) {
+        statusText = "failed to load D3D12/DXGI";
+        Logger::err("D3D12 DLAA host: failed to load D3D12 or DXGI.");
+        return false;
+      }
+
+      const auto createDevice =
+        reinterpret_cast<PFN_D3D12_CREATE_DEVICE>(
+          GetProcAddress(d3d12Module, "D3D12CreateDevice"));
+      using CreateFactoryFn = HRESULT (WINAPI*)(REFIID, void**);
+      const auto createFactory =
+        reinterpret_cast<CreateFactoryFn>(
+          GetProcAddress(dxgiModule, "CreateDXGIFactory1"));
+      if (!createDevice || !createFactory) {
+        statusText = "missing D3D12/DXGI entry point";
+        Logger::err(
+          "D3D12 DLAA host: D3D12CreateDevice/CreateDXGIFactory1 is unavailable.");
+        return false;
+      }
+
+      ComPtr<IDXGIFactory4> factory;
+      HRESULT hr = createFactory(IID_PPV_ARGS(&factory));
+      if (FAILED(hr)) {
+        statusText = "failed to create DXGI factory";
+        Logger::err(str::format(
+          "D3D12 DLAA host: CreateDXGIFactory1 failed: 0x",
+          std::hex,
+          static_cast<uint32_t>(hr)));
+        return false;
+      }
+
+      const VkPhysicalDeviceIDProperties& id =
+        device->adapter()->devicePropertiesExt().coreDeviceId;
+      if (!id.deviceLUIDValid) {
+        statusText = "Vulkan adapter has no valid LUID";
+        Logger::err(
+          "D3D12 DLAA host: Vulkan adapter did not expose a valid device LUID.");
+        return false;
+      }
+
+      for (uint32_t index = 0; ; index++) {
+        ComPtr<IDXGIAdapter1> candidate;
+        if (factory->EnumAdapters1(index, &candidate) == DXGI_ERROR_NOT_FOUND) {
+          break;
+        }
+
+        DXGI_ADAPTER_DESC1 desc = {};
+        if (FAILED(candidate->GetDesc1(&desc)) ||
+            !sameLuid(desc.AdapterLuid, id.deviceLUID)) {
+          continue;
+        }
+
+        hr = createDevice(
+          candidate.Get(),
+          D3D_FEATURE_LEVEL_11_0,
+          IID_PPV_ARGS(&d3d12Device));
+        if (SUCCEEDED(hr)) {
+          adapter = candidate;
+          break;
+        }
+      }
+
+      if (!d3d12Device) {
+        statusText = "failed to match Vulkan GPU in D3D12";
+        Logger::err(
+          "D3D12 DLAA host: no D3D12 adapter matched the Vulkan device LUID.");
+        return false;
+      }
+
+      D3D12_COMMAND_QUEUE_DESC queueDesc = {};
+      queueDesc.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+      queueDesc.Priority = D3D12_COMMAND_QUEUE_PRIORITY_NORMAL;
+      queueDesc.Flags = D3D12_COMMAND_QUEUE_FLAG_NONE;
+      queueDesc.NodeMask = 0;
+
+      hr = d3d12Device->CreateCommandQueue(
+        &queueDesc,
+        IID_PPV_ARGS(&queue));
+      if (FAILED(hr)) {
+        statusText = "failed to create D3D12 queue";
+        return false;
+      }
+
+      hr = d3d12Device->CreateCommandAllocator(
+        D3D12_COMMAND_LIST_TYPE_DIRECT,
+        IID_PPV_ARGS(&allocator));
+      if (FAILED(hr)) {
+        statusText = "failed to create D3D12 allocator";
+        return false;
+      }
+
+      hr = d3d12Device->CreateCommandList(
+        0,
+        D3D12_COMMAND_LIST_TYPE_DIRECT,
+        allocator.Get(),
+        nullptr,
+        IID_PPV_ARGS(&commandList));
+      if (FAILED(hr)) {
+        statusText = "failed to create D3D12 command list";
+        return false;
+      }
+      commandList->Close();
+
+      hr = d3d12Device->CreateFence(
+        0,
+        D3D12_FENCE_FLAG_NONE,
+        IID_PPV_ARGS(&fence));
+      if (FAILED(hr)) {
+        statusText = "failed to create D3D12 fence";
+        return false;
+      }
+
+      fenceEvent = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+      if (!fenceEvent) {
+        statusText = "failed to create D3D12 fence event";
+        return false;
+      }
+
+      if (!createInteropFence()) {
+        return false;
+      }
+
+      const std::filesystem::path appDirectory =
+        executableDirectory();
+      const NVSDK_NGX_Result ngxResult = NVSDK_NGX_D3D12_Init(
+        RtxOptions::applicationId(),
+        appDirectory.c_str(),
+        d3d12Device.Get(),
+        nullptr,
+        NVSDK_NGX_Version_API);
+      if (NVSDK_NGX_FAILED(ngxResult)) {
+        statusText = "NGX D3D12 initialization failed";
+        Logger::err(str::format(
+          "D3D12 DLAA host: NVSDK_NGX_D3D12_Init failed: 0x",
+          std::hex,
+          static_cast<uint32_t>(ngxResult)));
+        return false;
+      }
+      ngxInitialized = true;
+
+      const NVSDK_NGX_Result paramsResult =
+        NVSDK_NGX_D3D12_GetCapabilityParameters(&parameters);
+      if (NVSDK_NGX_FAILED(paramsResult) || !parameters) {
+        statusText = "NGX capability parameters unavailable";
+        Logger::err(str::format(
+          "D3D12 DLAA host: GetCapabilityParameters failed: 0x",
+          std::hex,
+          static_cast<uint32_t>(paramsResult)));
+        return false;
+      }
+
+      initialized = true;
+      statusText = "ready; waiting for shared DLAA resources";
+      Logger::info(
+        "D3D12 DLAA host: initialized on the Vulkan adapter LUID.");
+      return true;
+    }
+
+    bool createInteropFence() {
+      if (!device->extensions().khrExternalSemaphore ||
+          !device->extensions().khrExternalSemaphoreWin32 ||
+          !device->vkd()->vkGetSemaphoreWin32HandleKHR) {
+        statusText = "Vulkan external D3D12 fences unavailable";
+        Logger::err(
+          "D3D12 DLAA host: Vulkan external-semaphore support is unavailable.");
+        return false;
+      }
+
+      VkExportSemaphoreCreateInfo exportInfo = {};
+      exportInfo.sType =
+        VK_STRUCTURE_TYPE_EXPORT_SEMAPHORE_CREATE_INFO;
+      exportInfo.pNext = nullptr;
+      exportInfo.handleTypes =
+        VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_D3D12_FENCE_BIT;
+
+      VkSemaphoreTypeCreateInfo timelineInfo = {};
+      timelineInfo.sType =
+        VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO;
+      timelineInfo.pNext = &exportInfo;
+      timelineInfo.semaphoreType = VK_SEMAPHORE_TYPE_TIMELINE;
+      timelineInfo.initialValue = 0;
+
+      VkSemaphoreCreateInfo createInfo = {};
+      createInfo.sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO;
+      createInfo.pNext = &timelineInfo;
+
+      const VkResult createResult =
+        device->vkd()->vkCreateSemaphore(
+          device->handle(),
+          &createInfo,
+          nullptr,
+          &interopSemaphore);
+      if (createResult != VK_SUCCESS) {
+        statusText = "failed to create Vulkan interop fence";
+        Logger::err(str::format(
+          "D3D12 DLAA host: Vulkan timeline semaphore creation failed: ",
+          createResult));
+        return false;
+      }
+
+      VkSemaphoreGetWin32HandleInfoKHR handleInfo = {};
+      handleInfo.sType =
+        VK_STRUCTURE_TYPE_SEMAPHORE_GET_WIN32_HANDLE_INFO_KHR;
+      handleInfo.semaphore = interopSemaphore;
+      handleInfo.handleType =
+        VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_D3D12_FENCE_BIT;
+
+      HANDLE sharedHandle = INVALID_HANDLE_VALUE;
+      const VkResult exportResult =
+        device->vkd()->vkGetSemaphoreWin32HandleKHR(
+          device->handle(),
+          &handleInfo,
+          &sharedHandle);
+      if (exportResult != VK_SUCCESS ||
+          sharedHandle == INVALID_HANDLE_VALUE) {
+        statusText = "failed to export Vulkan interop fence";
+        Logger::err(str::format(
+          "D3D12 DLAA host: Vulkan fence export failed: ",
+          exportResult));
+        return false;
+      }
+
+      const HRESULT openResult =
+        d3d12Device->OpenSharedHandle(
+          sharedHandle,
+          IID_PPV_ARGS(&interopFence));
+      CloseHandle(sharedHandle);
+      if (FAILED(openResult)) {
+        statusText = "D3D12 rejected Vulkan interop fence";
+        Logger::err(str::format(
+          "D3D12 DLAA host: OpenSharedHandle for the Vulkan fence failed: 0x",
+          std::hex,
+          static_cast<uint32_t>(openResult)));
+        return false;
+      }
+
+      return true;
+    }
+
+    bool resetCommandList() {
+      if (FAILED(allocator->Reset())) {
+        statusText = "D3D12 command allocator reset failed";
+        return false;
+      }
+      if (FAILED(commandList->Reset(allocator.Get(), nullptr))) {
+        statusText = "D3D12 command-list reset failed";
+        return false;
+      }
+      return true;
+    }
+
+    bool executeAndWait(uint64_t releaseToVulkanValue = 0) {
+      if (FAILED(commandList->Close())) {
+        statusText = "D3D12 command-list close failed";
+        return false;
+      }
+
+      ID3D12CommandList* lists[] = { commandList.Get() };
+      queue->ExecuteCommandLists(1, lists);
+
+      if (releaseToVulkanValue != 0 &&
+          FAILED(queue->Signal(
+            interopFence.Get(),
+            releaseToVulkanValue))) {
+        statusText = "D3D12 interop-fence signal failed";
+        return false;
+      }
+
+      const uint64_t value = ++fenceValue;
+      if (FAILED(queue->Signal(fence.Get(), value))) {
+        statusText = "D3D12 queue signal failed";
+        return false;
+      }
+
+      if (fence->GetCompletedValue() < value) {
+        if (FAILED(fence->SetEventOnCompletion(value, fenceEvent))) {
+          statusText = "D3D12 fence wait setup failed";
+          return false;
+        }
+        WaitForSingleObject(fenceEvent, INFINITE);
+      }
+
+      return true;
+    }
+
+    bool createD3D12Texture(
+      SharedTexture& texture,
+      const VkExtent3D& extent,
+      DXGI_FORMAT format,
+      const wchar_t* name) {
+      D3D12_HEAP_PROPERTIES heap = {};
+      heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+      heap.CPUPageProperty = D3D12_CPU_PAGE_PROPERTY_UNKNOWN;
+      heap.MemoryPoolPreference = D3D12_MEMORY_POOL_UNKNOWN;
+      heap.CreationNodeMask = 1;
+      heap.VisibleNodeMask = 1;
+
+      D3D12_RESOURCE_DESC desc = {};
+      desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+      desc.Alignment = 0;
+      desc.Width = extent.width;
+      desc.Height = extent.height;
+      desc.DepthOrArraySize = 1;
+      desc.MipLevels = 1;
+      desc.Format = format;
+      desc.SampleDesc.Count = 1;
+      desc.SampleDesc.Quality = 0;
+      desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+      desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+
+      const HRESULT createResult =
+        d3d12Device->CreateCommittedResource(
+          &heap,
+          D3D12_HEAP_FLAG_SHARED,
+          &desc,
+          D3D12_RESOURCE_STATE_COMMON,
+          nullptr,
+          IID_PPV_ARGS(&texture.d3d12));
+      if (FAILED(createResult)) {
+        statusText = "failed to create shared D3D12 texture";
+        Logger::err(str::format(
+          "D3D12 DLAA host: CreateCommittedResource failed: 0x",
+          std::hex,
+          static_cast<uint32_t>(createResult)));
+        return false;
+      }
+
+      texture.d3d12->SetName(name);
+      const HRESULT shareResult = d3d12Device->CreateSharedHandle(
+        texture.d3d12.Get(),
+        nullptr,
+        GENERIC_ALL,
+        nullptr,
+        &texture.handle);
+      if (FAILED(shareResult)) {
+        statusText = "failed to export D3D12 texture";
+        Logger::err(str::format(
+          "D3D12 DLAA host: CreateSharedHandle failed: 0x",
+          std::hex,
+          static_cast<uint32_t>(shareResult)));
+        return false;
+      }
+
+      return true;
+    }
+
+    bool importIntoVulkan(
+      Rc<DxvkContext> ctx,
+      SharedTexture& texture,
+      const VkExtent3D& extent,
+      VkFormat format,
+      const char* name) {
+      DxvkImageCreateInfo imageInfo = {};
+      imageInfo.type = VK_IMAGE_TYPE_2D;
+      imageInfo.format = format;
+      imageInfo.flags = 0;
+      imageInfo.sampleCount = VK_SAMPLE_COUNT_1_BIT;
+      imageInfo.extent = extent;
+      imageInfo.numLayers = 1;
+      imageInfo.mipLevels = 1;
+      imageInfo.usage =
+        VK_IMAGE_USAGE_SAMPLED_BIT |
+        VK_IMAGE_USAGE_STORAGE_BIT |
+        VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+        VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+      imageInfo.stages =
+        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT |
+        VK_PIPELINE_STAGE_TRANSFER_BIT;
+      imageInfo.access =
+        VK_ACCESS_SHADER_READ_BIT |
+        VK_ACCESS_SHADER_WRITE_BIT |
+        VK_ACCESS_TRANSFER_READ_BIT |
+        VK_ACCESS_TRANSFER_WRITE_BIT;
+      imageInfo.tiling = VK_IMAGE_TILING_OPTIMAL;
+      imageInfo.layout = VK_IMAGE_LAYOUT_GENERAL;
+      imageInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+      imageInfo.shared = VK_TRUE;
+      imageInfo.sharing.mode = DxvkSharedHandleMode::Import;
+      imageInfo.sharing.type =
+        VK_EXTERNAL_MEMORY_HANDLE_TYPE_D3D12_RESOURCE_BIT;
+      imageInfo.sharing.handle = texture.handle;
+
+      texture.vulkan.image = device->createImage(
+        imageInfo,
+        VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
+        DxvkMemoryStats::Category::RTXRenderTarget,
+        name);
+      if (!texture.vulkan.image->isExternallyShared()) {
+        texture.vulkan.reset();
+        statusText = "Vulkan rejected D3D12 shared texture";
+        Logger::err(str::format(
+          "D3D12 DLAA host: external-memory import was rejected for ",
+          name,
+          "."));
+        return false;
+      }
+
+      DxvkImageViewCreateInfo viewInfo = {};
+      viewInfo.type = VK_IMAGE_VIEW_TYPE_2D;
+      viewInfo.format = format;
+      viewInfo.usage = imageInfo.usage;
+      viewInfo.aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+      viewInfo.minLevel = 0;
+      viewInfo.numLevels = 1;
+      viewInfo.minLayer = 0;
+      viewInfo.numLayers = 1;
+      texture.vulkan.view =
+        device->createImageView(texture.vulkan.image, viewInfo);
+
+      ctx->changeImageLayout(
+        texture.vulkan.image,
+        VK_IMAGE_LAYOUT_GENERAL);
+      return true;
+    }
+
+    bool createSharedTexture(
+      Rc<DxvkContext> ctx,
+      SharedTexture& texture,
+      const VkExtent3D& extent,
+      DXGI_FORMAT dxgiFormat,
+      VkFormat vkFormat,
+      const wchar_t* d3dName,
+      const char* vkName) {
+      return createD3D12Texture(
+          texture,
+          extent,
+          dxgiFormat,
+          d3dName) &&
+        importIntoVulkan(
+          ctx,
+          texture,
+          extent,
+          vkFormat,
+          vkName);
+    }
+
+    bool createFeature() {
+      if (!resetCommandList()) {
+        return false;
+      }
+
+      parameters->Set(
+        NVSDK_NGX_Parameter_DLSS_Hint_Render_Preset_DLAA,
+        static_cast<int>(NVSDK_NGX_DLSS_Hint_Render_Preset_M));
+      parameters->Set(
+        NVSDK_NGX_Parameter_FreeMemOnReleaseFeature,
+        1);
+
+      NVSDK_NGX_DLSS_Create_Params createParams = {};
+      createParams.Feature.InWidth = extent.width;
+      createParams.Feature.InHeight = extent.height;
+      createParams.Feature.InTargetWidth = extent.width;
+      createParams.Feature.InTargetHeight = extent.height;
+      createParams.Feature.InPerfQualityValue =
+        NVSDK_NGX_PerfQuality_Value_DLAA;
+      createParams.InFeatureCreateFlags =
+        NVSDK_NGX_DLSS_Feature_Flags_MVLowRes |
+        NVSDK_NGX_DLSS_Feature_Flags_AutoExposure;
+      createParams.InEnableOutputSubrects = false;
+
+      const NVSDK_NGX_Result result = NGX_D3D12_CREATE_DLSS_EXT(
+        commandList.Get(),
+        1,
+        1,
+        &feature,
+        parameters,
+        &createParams);
+      if (NVSDK_NGX_FAILED(result) || !feature) {
+        commandList->Close();
+        statusText = "D3D12 NGX DLAA feature creation failed";
+        Logger::err(str::format(
+          "D3D12 DLAA host: NGX feature creation failed: 0x",
+          std::hex,
+          static_cast<uint32_t>(result)));
+        return false;
+      }
+
+      if (!executeAndWait()) {
+        return false;
+      }
+
+      statusText = "D3D12 DLAA ready; ReShade add-on may attach";
+      Logger::info(str::format(
+        "D3D12 DLAA host: created native-resolution DLAA feature at ",
+        extent.width,
+        "x",
+        extent.height,
+        "."));
+      return true;
+    }
+
+    void releaseFeature() {
+      if (feature) {
+        NVSDK_NGX_D3D12_ReleaseFeature(feature);
+        feature = nullptr;
+      }
+    }
+
+    void releaseSharedTextures() {
+      color.reset();
+      depth.reset();
+      motion.reset();
+      output.reset();
+      extent = {};
+    }
+
+    bool ensureResources(
+      Rc<DxvkContext> ctx,
+      const VkExtent3D& requestedExtent) {
+      if (!initializeHost()) {
+        return false;
+      }
+
+      if (feature &&
+          extent.width == requestedExtent.width &&
+          extent.height == requestedExtent.height &&
+          color.vulkan.isValid() &&
+          depth.vulkan.isValid() &&
+          motion.vulkan.isValid() &&
+          output.vulkan.isValid()) {
+        return true;
+      }
+
+      // Make sure neither API can still reference allocations being replaced.
+      ctx->flushCommandList();
+      device->waitForIdle();
+      waitForD3D12Idle();
+
+      releaseFeature();
+      releaseSharedTextures();
+      extent = requestedExtent;
+
+      const bool resourcesCreated =
+        createSharedTexture(
+          ctx,
+          color,
+          extent,
+          DXGI_FORMAT_R16G16B16A16_FLOAT,
+          VK_FORMAT_R16G16B16A16_SFLOAT,
+          L"FNV DLAA Color",
+          "FNV DLAA shared color") &&
+        createSharedTexture(
+          ctx,
+          depth,
+          extent,
+          DXGI_FORMAT_R32_FLOAT,
+          VK_FORMAT_R32_SFLOAT,
+          L"FNV DLAA Depth",
+          "FNV DLAA shared depth") &&
+        createSharedTexture(
+          ctx,
+          motion,
+          extent,
+          DXGI_FORMAT_R16G16_FLOAT,
+          VK_FORMAT_R16G16_SFLOAT,
+          L"FNV DLAA Motion",
+          "FNV DLAA shared motion") &&
+        createSharedTexture(
+          ctx,
+          output,
+          extent,
+          DXGI_FORMAT_R16G16B16A16_FLOAT,
+          VK_FORMAT_R16G16B16A16_SFLOAT,
+          L"FNV DLAA Output",
+          "FNV DLAA shared output");
+      if (!resourcesCreated) {
+        releaseSharedTextures();
+        return false;
+      }
+
+      if (!createFeature()) {
+        releaseSharedTextures();
+        return false;
+      }
+
+      return true;
+    }
+
+    bool evaluate(
+      Rc<DxvkContext> ctx,
+      bool resetHistory,
+      float jitterX,
+      float jitterY) {
+      if (!interopSemaphore || !interopFence) {
+        statusText = "cross-API synchronization unavailable";
+        return false;
+      }
+
+      const uint64_t readyForD3D12Value = ++interopFenceValue;
+      ctx->getCommandList()->addSignalSemaphore(
+        interopSemaphore,
+        readyForD3D12Value);
+      ctx->flushCommandList();
+
+      if (FAILED(queue->Wait(
+            interopFence.Get(),
+            readyForD3D12Value))) {
+        statusText = "D3D12 interop-fence wait failed";
+        return false;
+      }
+
+      if (!feature || !resetCommandList()) {
+        return false;
+      }
+
+      std::array<D3D12_RESOURCE_BARRIER, 4> acquire = {
+        transition(
+          color.d3d12.Get(),
+          D3D12_RESOURCE_STATE_COMMON,
+          D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE),
+        transition(
+          depth.d3d12.Get(),
+          D3D12_RESOURCE_STATE_COMMON,
+          D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE),
+        transition(
+          motion.d3d12.Get(),
+          D3D12_RESOURCE_STATE_COMMON,
+          D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE),
+        transition(
+          output.d3d12.Get(),
+          D3D12_RESOURCE_STATE_COMMON,
+          D3D12_RESOURCE_STATE_UNORDERED_ACCESS)
+      };
+      commandList->ResourceBarrier(
+        static_cast<UINT>(acquire.size()),
+        acquire.data());
+
+      NVSDK_NGX_D3D12_DLSS_Eval_Params eval = {};
+      eval.Feature.pInColor = color.d3d12.Get();
+      eval.Feature.pInOutput = output.d3d12.Get();
+      eval.Feature.InSharpness = 0.0f;
+      eval.pInDepth = depth.d3d12.Get();
+      eval.pInMotionVectors = motion.d3d12.Get();
+      eval.InJitterOffsetX = jitterX;
+      eval.InJitterOffsetY = jitterY;
+      eval.InRenderSubrectDimensions.Width = extent.width;
+      eval.InRenderSubrectDimensions.Height = extent.height;
+      eval.InReset = resetHistory ? 1 : 0;
+      eval.InMVScaleX = 1.0f;
+      eval.InMVScaleY = 1.0f;
+      eval.InPreExposure = 1.0f;
+      eval.InExposureScale = 1.0f;
+
+      const NVSDK_NGX_Result ngxResult =
+        NGX_D3D12_EVALUATE_DLSS_EXT(
+          commandList.Get(),
+          feature,
+          parameters,
+          &eval);
+
+      std::array<D3D12_RESOURCE_BARRIER, 4> releaseBarriers = {
+        transition(
+          color.d3d12.Get(),
+          D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+          D3D12_RESOURCE_STATE_COMMON),
+        transition(
+          depth.d3d12.Get(),
+          D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+          D3D12_RESOURCE_STATE_COMMON),
+        transition(
+          motion.d3d12.Get(),
+          D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+          D3D12_RESOURCE_STATE_COMMON),
+        transition(
+          output.d3d12.Get(),
+          D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+          D3D12_RESOURCE_STATE_COMMON)
+      };
+      commandList->ResourceBarrier(
+        static_cast<UINT>(releaseBarriers.size()),
+        releaseBarriers.data());
+
+      if (NVSDK_NGX_FAILED(ngxResult)) {
+        commandList->Close();
+        statusText = "D3D12 NGX DLAA evaluation failed";
+        Logger::warn(str::format(
+          "D3D12 DLAA host: NGX evaluation failed: 0x",
+          std::hex,
+          static_cast<uint32_t>(ngxResult)));
+        return false;
+      }
+
+      const uint64_t readyForVulkanValue = ++interopFenceValue;
+      if (!executeAndWait(readyForVulkanValue)) {
+        return false;
+      }
+
+      ctx->getCommandList()->addWaitSemaphore(
+        interopSemaphore,
+        readyForVulkanValue);
+
+      statusText = "D3D12 DLAA evaluations active";
+      return true;
+    }
+
+    void waitForD3D12Idle() {
+      if (!queue || !fence || !fenceEvent) {
+        return;
+      }
+
+      const uint64_t value = ++fenceValue;
+      if (FAILED(queue->Signal(fence.Get(), value))) {
+        return;
+      }
+
+      if (fence->GetCompletedValue() < value &&
+          SUCCEEDED(fence->SetEventOnCompletion(value, fenceEvent))) {
+        WaitForSingleObject(fenceEvent, INFINITE);
+      }
+    }
+
+    void release() {
+      if (device) {
+        device->waitForIdle();
+      }
+      waitForD3D12Idle();
+
+      releaseFeature();
+      releaseSharedTextures();
+
+      if (parameters) {
+        NVSDK_NGX_D3D12_DestroyParameters(parameters);
+        parameters = nullptr;
+      }
+      if (ngxInitialized) {
+        NVSDK_NGX_D3D12_Shutdown1(d3d12Device.Get());
+        ngxInitialized = false;
+      }
+
+      if (fenceEvent) {
+        CloseHandle(fenceEvent);
+        fenceEvent = nullptr;
+      }
+
+      commandList.Reset();
+      allocator.Reset();
+      queue.Reset();
+      fence.Reset();
+      interopFence.Reset();
+      if (interopSemaphore) {
+        device->vkd()->vkDestroySemaphore(
+          device->handle(),
+          interopSemaphore,
+          nullptr);
+        interopSemaphore = VK_NULL_HANDLE;
+      }
+      d3d12Device.Reset();
+      adapter.Reset();
+
+      if (dxgiModule) {
+        FreeLibrary(dxgiModule);
+        dxgiModule = nullptr;
+      }
+      if (d3d12Module) {
+        FreeLibrary(d3d12Module);
+        d3d12Module = nullptr;
+      }
+
+      initialized = false;
+      statusText = "not initialized";
+    }
+
+    DxvkDevice* device = nullptr;
+    HMODULE d3d12Module = nullptr;
+    HMODULE dxgiModule = nullptr;
+    ComPtr<IDXGIAdapter1> adapter;
+    ComPtr<ID3D12Device> d3d12Device;
+    ComPtr<ID3D12CommandQueue> queue;
+    ComPtr<ID3D12CommandAllocator> allocator;
+    ComPtr<ID3D12GraphicsCommandList> commandList;
+    ComPtr<ID3D12Fence> fence;
+    ComPtr<ID3D12Fence> interopFence;
+    VkSemaphore interopSemaphore = VK_NULL_HANDLE;
+    HANDLE fenceEvent = nullptr;
+    uint64_t fenceValue = 0;
+    uint64_t interopFenceValue = 0;
+
+    NVSDK_NGX_Parameter* parameters = nullptr;
+    NVSDK_NGX_Handle* feature = nullptr;
+    bool ngxInitialized = false;
+    bool initialized = false;
+
+    VkExtent3D extent = {};
+    SharedTexture color;
+    SharedTexture depth;
+    SharedTexture motion;
+    SharedTexture output;
+    const char* statusText = "not initialized";
+  };
+
+  D3D12DlaaInterop::D3D12DlaaInterop(DxvkDevice* device)
+  : m_impl(std::make_unique<Impl>(device)) {
+  }
+
+  D3D12DlaaInterop::~D3D12DlaaInterop() = default;
+
+  bool D3D12DlaaInterop::ensureResources(
+    Rc<DxvkContext> ctx,
+    const VkExtent3D& extent) {
+    return m_impl->ensureResources(std::move(ctx), extent);
+  }
+
+  bool D3D12DlaaInterop::evaluate(
+    Rc<DxvkContext> ctx,
+    bool resetHistory,
+    float jitterX,
+    float jitterY) {
+    return m_impl->evaluate(
+      std::move(ctx),
+      resetHistory,
+      jitterX,
+      jitterY);
+  }
+
+  void D3D12DlaaInterop::release() {
+    m_impl->release();
+  }
+
+  bool D3D12DlaaInterop::isInitialized() const {
+    return m_impl->initialized;
+  }
+
+  const char* D3D12DlaaInterop::status() const {
+    return m_impl->statusText;
+  }
+
+  const Resources::Resource& D3D12DlaaInterop::color() const {
+    return m_impl->color.vulkan;
+  }
+
+  const Resources::Resource& D3D12DlaaInterop::depth() const {
+    return m_impl->depth.vulkan;
+  }
+
+  const Resources::Resource& D3D12DlaaInterop::motion() const {
+    return m_impl->motion.vulkan;
+  }
+
+  const Resources::Resource& D3D12DlaaInterop::output() const {
+    return m_impl->output.vulkan;
+  }
+
+}
