diff --git a/FalloutNV-Remix-Wrapper/src/comp/d3d9_proxy.cpp b/FalloutNV-Remix-Wrapper/src/comp/d3d9_proxy.cpp
index 30cbf36..0d147ba 100644
--- a/FalloutNV-Remix-Wrapper/src/comp/d3d9_proxy.cpp
