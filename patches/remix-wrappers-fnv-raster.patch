@@ -20,6 +20,69 @@ namespace d3d9_proxy
 	static FARPROC pDebugSetLevel = nullptr;
 	static FARPROC pDebugSetMute = nullptr;
 
+	static void configure_reshade_layer_for_bridge()
+	{
+		// Steam starts FalloutNV.exe from its already-running client, so temporary
+		// launcher environment variables are not reliable. Configure everything
+		// needed by the 64-bit renderer so FalloutNV.exe can be launched
+		// directly.
+		SetEnvironmentVariableW(L"DXVK_FORCE_WINDOWED", L"1");
+
+		wchar_t executable_path[32768]{};
+		const auto path_length = GetModuleFileNameW(
+			nullptr,
+			executable_path,
+			static_cast<DWORD>(std::size(executable_path)));
+
+		if (!path_length || path_length >= std::size(executable_path))
+		{
+			shared::common::log(
+				"Proxy",
+				std::format("Could not resolve game path for private ReShade layer (error 0x{:X})", GetLastError()),
+				shared::common::LOG_TYPE::LOG_TYPE_WARN);
+			return;
+		}
+
+		std::wstring game_path(executable_path, path_length);
+		const auto separator = game_path.find_last_of(L"\\/");
+		if (separator == std::wstring::npos)
+		{
+			shared::common::log(
+				"Proxy",
+				"Could not resolve game directory for private ReShade layer",
+				shared::common::LOG_TYPE::LOG_TYPE_WARN);
+			return;
+		}
+
+		const auto layer_path = game_path.substr(0, separator) + L"\\.trex\\reshade-layer";
+		const auto manifest_path = layer_path + L"\\ReShade64.json";
+		const auto attributes = GetFileAttributesW(manifest_path.c_str());
+
+		if (attributes == INVALID_FILE_ATTRIBUTES || (attributes & FILE_ATTRIBUTE_DIRECTORY))
+		{
+			shared::common::log(
+				"Proxy",
+				"Private ReShade Vulkan layer manifest is missing; bridge will continue without it",
+				shared::common::LOG_TYPE::LOG_TYPE_WARN);
+			return;
+		}
+
+		if (!SetEnvironmentVariableW(L"VK_IMPLICIT_LAYER_PATH", layer_path.c_str()))
+		{
+			shared::common::log(
+				"Proxy",
+				std::format("Could not set private ReShade layer path (error 0x{:X})", GetLastError()),
+				shared::common::LOG_TYPE::LOG_TYPE_WARN);
+			return;
+		}
+
+		SetEnvironmentVariableW(L"VK_ADD_IMPLICIT_LAYER_PATH", nullptr);
+		SetEnvironmentVariableW(L"DISABLE_VK_LAYER_reshade_1", nullptr);
+		shared::common::log(
+			"Proxy",
+			"Direct-launch environment configured for the 64-bit Remix bridge");
+	}
+
 	static void resolve_procs(HMODULE mod)
 	{
 		pDirect3DCreate9                = (PFN_Direct3DCreate9)GetProcAddress(mod, "Direct3DCreate9");
@@ -72,6 +135,7 @@ namespace d3d9_proxy
 		// Try Remix bridge first (e.g. d3d9_remix.dll sitting next to us)
 		if (cfg.remix.enabled && !cfg.remix.dll_name.empty())
